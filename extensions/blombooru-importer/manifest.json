{
  "manifest_version": 3,
  "name": "Blombooru Web Importer",
  "version": "0.3.0",
  "description": "Import images from any site, ExHentai, Pixiv, and Sankaku into Blombooru.",
  "permissions": ["storage", "contextMenus", "scripting", "activeTab"],
  "host_permissions": [
    "https://www.pixiv.net/*",
    "https://i.pximg.net/*",
    "https://exhentai.org/*",
    "https://e-hentai.org/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Blombooru Web Importer",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.pixiv.net/*/artworks/*",
        "https://www.pixiv.net/*/users/*/bookmarks/artworks*",
        "https://www.pixiv.net/users/*/bookmarks/artworks*",
        "https://chan.sankakucomplex.com/*/posts*",
        "https://chan.sankakucomplex.com/posts*",
        "https://exhentai.org/*",
        "https://e-hentai.org/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
